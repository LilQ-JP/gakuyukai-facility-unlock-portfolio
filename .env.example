HOST=127.0.0.1
PORT=8787
BASE_URL=http://localhost:8787
ADMIN_TOKEN=replace-with-a-long-random-value

# Discord webhooks. Keep the admin channel private.
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_ORGANIZATION_WEBHOOK_URL=

# Deprecated: organization-channel fallback during migration only.
DISCORD_WEBHOOK_URL=

# Email. Keep EMAIL_MODE=log for local development.
EMAIL_MODE=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SwitchBot OpenAPI v1.1 credentials.
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Set to false only when real SwitchBot credentials and room device IDs are ready.
SWITCHBOT_MOCK=true

# Optional safety window in minutes.
PASSCODE_START_BUFFER_MINUTES=10
PASSCODE_END_BUFFER_MINUTES=10

# Optional Tailscale one-off auth key for the "tailscale" Docker Compose profile.
TAILSCALE_AUTHKEY=
